# Required in production (≥16 chars).
AUTH_SECRET=replace-with-long-random-string-16+
# Owner-only admin station (/admin). Comma-separated allowed.
ADMIN_EMAIL=357itsumi@proton.me
# ADMIN_EMAILS=357itsumi@proton.me
# Optional public origin for Stripe return URLs (defaults to www.kamaunegasi.net).
# SITE_URL=https://www.kamaunegasi.net
# Gates (wrangler [vars] defaults to on). Set to 0 to disable.
# ACCOUNT_GATE=1
# AGE_GATE_REQUIRED=1
# Production: stripe. Local: demo + ALLOW_DEMO_PAYMENTS=1
PAYMENTS_MODE=demo
ALLOW_DEMO_PAYMENTS=1
# Never enable in production Workers — auth must use AUTH_KV.
# ALLOW_MEMORY_AUTH=1
# PAYMENTS_MODE=stripe
# STRIPE_SECRET_KEY=sk_live_or_test
# STRIPE_WEBHOOK_SECRET=shared-secret-16+
