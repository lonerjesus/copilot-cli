# Cloudflare Pages–style static cache only.
# App security headers: middleware → src/lib/security-headers.ts (single source).
# Do not re-add CSP/HSTS/XFO here or in CF Transform Rules for the Worker.

/api/*
  Cache-Control: private, no-store

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/og.png
  Cache-Control: public, max-age=86400
