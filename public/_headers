# Security headers for Cloudflare Pages–style static deploys.
# Workers / OpenNext runtime headers come from src/lib/security-headers.ts
# (middleware + next.config). Keep Cache-Control rules here only.

/api/*
  Cache-Control: private, no-store

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/og.png
  Cache-Control: public, max-age=86400
