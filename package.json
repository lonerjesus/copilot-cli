{
  "name": "kamaunegasi-net",
  "version": "1.0.0",
  "private": true,
  "description": "www.kamaunegasi.net — autonomous portfolio & vlog streaming platform",
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "build:next": "next build",
    "start": "next start",
    "lint": "eslint",
