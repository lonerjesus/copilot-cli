{
  "name": "kamaunegasi-net",
  "version": "1.0.0",
  "private": true,
  "description": "www.kamaunegasi.net — autonomous portfolio & vlog streaming platform",
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "build:next": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:ensure-r2": "bash scripts/ensure-r2-bucket.sh",
    "qa:smoke": "bash scripts/qa-smoke.sh \"${BASE:-http://127.0.0.1:3000}\"",
    "qa:av": "node --experimental-strip-types scripts/check-av-upload-types.mjs",
    "qa:player-av": "node --experimental-strip-types scripts/check-player-av.mjs",
    "qa:av-e2e": "node scripts/e2e-av-upload.mjs",
    "qa:edit-save": "node scripts/e2e-admin-edit-save.mjs",
    "qa:media-ref": "node --experimental-strip-types scripts/check-media-ref.mjs",
    "qa:player-queue": "node --experimental-strip-types scripts/check-player-queue.mjs",
    "qa:playable-house": "node --experimental-strip-types scripts/check-playable-house.mjs",
    "qa:large-av": "node --experimental-strip-types scripts/check-large-av-upload.mjs",
    "qa:media-meta": "node --experimental-strip-types scripts/check-media-meta.mjs",
    "qa:collection-zip": "node --experimental-strip-types scripts/check-collection-zip.mjs",
    "qa:batch-collection": "node scripts/e2e-batch-collection.mjs",
    "qa:media-range": "node scripts/e2e-media-range.mjs",
    "qa:writing-open": "node --experimental-strip-types scripts/e2e-writing-open.mjs",
    "qa:platform-compare": "node --experimental-strip-types scripts/e2e-platform-compare.mjs",
    "qa:hero-play": "node scripts/e2e-hero-play.mjs",
    "qa:playback-memory": "node --experimental-strip-types scripts/check-playback-memory.mjs",
    "qa:guest": "node scripts/e2e-guest-user.mjs",
    "qa:player-blob": "node scripts/e2e-player-blob.mjs",
    "qa:gate": "bash scripts/qa-gate.sh"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "wrangler": "^4.147.0"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright": "^1.55.1"
  },
  "engines": {
    "node": ">=22"
  }
}
